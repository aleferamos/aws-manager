FROM node:22-alpine AS api-deps

WORKDIR /app

COPY Api/package*.json ./
RUN npm ci

FROM api-deps AS api-build

COPY Api/ .
RUN npm run build

FROM node:22-alpine AS api-prod

WORKDIR /app

COPY Api/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=api-build /app/dist ./dist

FROM node:22-alpine AS web-build

WORKDIR /app

COPY Web/package*.json ./
RUN npm ci

COPY Web/ .
ARG API_URL=/api
RUN sed -i "s#apiUrl: 'http://localhost:3000'#apiUrl: '${API_URL}'#g" src/environments/environment.ts \
  && npm run build

FROM postgres:17-alpine

LABEL org.opencontainers.image.title="AWS Manager" \
      org.opencontainers.image.description="Open-source self-hosted gateway for AWS access management." \
      org.opencontainers.image.version="1.1.0"

RUN apk add --no-cache bash nginx nodejs tini

ENV NODE_ENV=production \
    PORT=3000

COPY --from=api-prod /app /opt/aws-manager/api
COPY --from=web-build /app/dist/Web/browser /usr/share/nginx/html
COPY Docker/postgres/init.sql /docker-entrypoint-initdb.d/init.sql
COPY Docker/postgres/migrations /opt/aws-manager/db/migrations
COPY Docker/all-in-one/nginx.conf /etc/nginx/http.d/default.conf
COPY Docker/all-in-one/start.sh /usr/local/bin/aws-manager-start

RUN chmod +x /usr/local/bin/aws-manager-start \
  && mkdir -p /run/nginx /var/log/nginx

EXPOSE 80

VOLUME ["/var/lib/postgresql/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -q -O - http://127.0.0.1/api/ >/dev/null || exit 1

ENTRYPOINT ["tini", "--", "/usr/local/bin/aws-manager-start"]
